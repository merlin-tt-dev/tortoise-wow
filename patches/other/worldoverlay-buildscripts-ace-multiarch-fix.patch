diff --git a/worldoverlay-full-build.sh b/worldoverlay-full-build.sh
index 19c8c01..56c38b0 100755
--- a/worldoverlay-full-build.sh
+++ b/worldoverlay-full-build.sh
@@ -18,6 +18,21 @@ if [[ ! -f "${ACE_ROOT}/include/ace/Basic_Types.h" ]]; then
     exit 2
 fi
 
+ace_library_available() {
+    if command -v ldconfig >/dev/null 2>&1 && \
+       ldconfig -p 2>/dev/null | grep -qE 'libACE\.so([.[:space:]]|$)'; then
+        return 0
+    fi
+
+    compgen -G "${ACE_ROOT}/lib/libACE.so*" >/dev/null ||
+    compgen -G "${ACE_ROOT}/lib64/libACE.so*" >/dev/null ||
+    compgen -G "${ACE_ROOT}/lib/*/libACE.so*" >/dev/null
+}
+
+if ! ace_library_available; then
+    echo "WARNING: ACE library not found in the linker cache or below ${ACE_ROOT}/lib{,64} (including multiarch subdirectories)."
+fi
+
 if ! command -v cmake >/dev/null || ! command -v ninja >/dev/null; then
     echo "ERROR: cmake and ninja must be installed." >&2
     exit 2
diff --git a/worldoverlay-module-only-build.sh b/worldoverlay-module-only-build.sh
index 267deca..c728a4f 100755
--- a/worldoverlay-module-only-build.sh
+++ b/worldoverlay-module-only-build.sh
@@ -6,9 +6,9 @@ set -Eeuo pipefail
 # target (mod_mod_worldoverlay) instead of compiling the full static modules
 # aggregate / game core.
 #
-# Manjaro/AUR ACE is expected in the standard locations used by FindACE.cmake:
-#   /usr/include/ace/ACE.h
-#   /usr/lib/libACE.so (or versioned symlink/soname)
+# ACE may live in distro-specific multiarch library directories.
+# CMake's FindACE.cmake remains authoritative; the checks below only provide
+# early diagnostics without assuming a single /usr/lib layout.
 
 ROOT="${ROOT:-$(pwd)}"
 BUILD_DIR="${BUILD_DIR:-$ROOT/build-worldoverlay-module-audit}"
@@ -30,15 +30,28 @@ if ! command -v ninja >/dev/null 2>&1; then
     exit 2
 fi
 
-# ACE AUR/system sanity check. CMake's own FindACE.cmake remains authoritative.
-if [[ ! -f /usr/include/ace/ACE.h ]]; then
-    echo "WARNING: /usr/include/ace/ACE.h not found."
+# ACE system sanity check. CMake's own FindACE.cmake remains authoritative.
+ACE_PREFIX="${ACE_ROOT:-/usr}"
+
+if [[ ! -f "${ACE_PREFIX}/include/ace/ACE.h" ]]; then
+    echo "WARNING: ${ACE_PREFIX}/include/ace/ACE.h not found."
     echo "         If ACE is installed in a custom prefix, run e.g.:"
     echo "         ACE_ROOT=/opt/ace $0"
 fi
 
-if ! compgen -G '/usr/lib/libACE.so*' >/dev/null && [[ -z "${ACE_ROOT:-}" ]]; then
-    echo "WARNING: /usr/lib/libACE.so* not found and ACE_ROOT is unset."
+ace_library_available() {
+    if command -v ldconfig >/dev/null 2>&1 && \
+       ldconfig -p 2>/dev/null | grep -qE 'libACE\.so([.[:space:]]|$)'; then
+        return 0
+    fi
+
+    compgen -G "${ACE_PREFIX}/lib/libACE.so*" >/dev/null ||
+    compgen -G "${ACE_PREFIX}/lib64/libACE.so*" >/dev/null ||
+    compgen -G "${ACE_PREFIX}/lib/*/libACE.so*" >/dev/null
+}
+
+if ! ace_library_available; then
+    echo "WARNING: ACE library not found in the linker cache or below ${ACE_PREFIX}/lib{,64} (including multiarch subdirectories)."
 fi
 
 NPROC="$(nproc)"
