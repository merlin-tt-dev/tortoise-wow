+    if (!query || !navMesh)
+        return NAV_EMPTY;
+
+    dtQueryFilter filter;
+    filter.setIncludeFlags(NAV_GROUND | NAV_WATER | NAV_MAGMA | NAV_SLIME | NAV_STEEP_SLOPES);
+
+    float point[VERTEX_SIZE] = { y, z, x };
+    float extents[VERTEX_SIZE] = { 5.0f, 5.0f, 5.0f };
+    float closestPoint[VERTEX_SIZE] = { 0.0f, 0.0f, 0.0f };
+    dtPolyRef polyRef = INVALID_POLYREF;
+    if (dtStatusFailed(query->findNearestPoly(point, extents, &filter, &polyRef, closestPoint)) || polyRef == INVALID_POLYREF)
+        return NAV_EMPTY;
+
+    unsigned short flags = NAV_EMPTY;
+    return dtStatusSucceed(navMesh->getPolyFlags(polyRef, &flags)) ? flags : NAV_EMPTY;
+}
