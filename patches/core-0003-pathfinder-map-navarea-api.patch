+
+bool PathInfo::MarkNavArea(float x, float y, float z, uint8 area, float range)
+{
+    if (!MaNGOS::IsValidMapCoord(x, y, z) || area >= DT_MAX_AREAS)
+        return false;
+
+    MMAP::MMapManager* mmap = MMAP::MMapFactory::createOrGetMMapManager();
+    dtNavMeshQuery const* query = mmap->GetNavMeshQuery(m_mapId);
+    dtNavMesh const* constNavMesh = mmap->GetNavMesh(m_mapId);
+    if (!query || !constNavMesh)
+        return false;
+
+    dtQueryFilter filter;
+    filter.setIncludeFlags(NAV_GROUND | NAV_WATER);
+    filter.setExcludeFlags(NAV_MAGMA | NAV_SLIME | NAV_STEEP_SLOPES);
+
+    float point[VERTEX_SIZE] = { y, z, x };
+    float extents[VERTEX_SIZE] = { 5.0f, 5.0f, 5.0f };
+    float closestPoint[VERTEX_SIZE] = { 0.0f, 0.0f, 0.0f };
+    dtPolyRef startPoly = INVALID_POLYREF;
+    if (dtStatusFailed(query->findNearestPoly(point, extents, &filter, &startPoly, closestPoint)) || startPoly == INVALID_POLYREF)
+        return false;
+
+    static constexpr int MAX_POLYS = 2560;
+    std::array<dtPolyRef, MAX_POLYS> polys{};
+    int polyCount = 0;
+    if (dtStatusFailed(query->findPolysAroundCircle(startPoly, closestPoint, range, &filter,
+        polys.data(), nullptr, nullptr, &polyCount, MAX_POLYS)))
+        return false;
+
+    dtNavMesh* navMesh = const_cast<dtNavMesh*>(constNavMesh);
+    bool changed = false;
+    for (int i = 0; i < polyCount; ++i)
+    {
+        unsigned char currentArea = 0;
+        if (dtStatusFailed(navMesh->getPolyArea(polys[i], &currentArea)))
+            continue;
+
+        // Preserve hazardous liquid areas and do not lower a stronger dynamic avoidance mark.
+        if (currentArea != AREA_MAGMA && currentArea != AREA_SLIME && currentArea < area && dtStatusSucceed(navMesh->setPolyArea(polys[i], area)))
+            changed = true;
+    }
+
+    return changed;
+}
+
+uint8 PathInfo::GetNavArea(float x, float y, float z) const
+{
+    if (!MaNGOS::IsValidMapCoord(x, y, z))
+        return AREA_NONE;
+
+    MMAP::MMapManager* mmap = MMAP::MMapFactory::createOrGetMMapManager();
+    dtNavMeshQuery const* query = mmap->GetNavMeshQuery(m_mapId);
+    dtNavMesh const* navMesh = mmap->GetNavMesh(m_mapId);
+    if (!query || !navMesh)
+        return AREA_NONE;
+
+    dtQueryFilter filter;
+    filter.setIncludeFlags(NAV_GROUND | NAV_WATER | NAV_MAGMA | NAV_SLIME | NAV_STEEP_SLOPES);
+
+    float point[VERTEX_SIZE] = { y, z, x };
+    float extents[VERTEX_SIZE] = { 5.0f, 5.0f, 5.0f };
+    float closestPoint[VERTEX_SIZE] = { 0.0f, 0.0f, 0.0f };
+    dtPolyRef polyRef = INVALID_POLYREF;
+    if (dtStatusFailed(query->findNearestPoly(point, extents, &filter, &polyRef, closestPoint)) || polyRef == INVALID_POLYREF)
+        return AREA_NONE;
+
+    unsigned char area = AREA_NONE;
+    return dtStatusSucceed(navMesh->getPolyArea(polyRef, &area)) ? area : AREA_NONE;
+}
+
