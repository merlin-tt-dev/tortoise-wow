+struct FileCloser
+{
+    void operator()(FILE* file) const
+    {
+        if (file)
+            fclose(file);
+    }
+};
+
+struct DetourDataDeleter
+{
+    void operator()(unsigned char* data) const
+    {
+        if (data)
+            dtFree(data);
+    }
+};
+
