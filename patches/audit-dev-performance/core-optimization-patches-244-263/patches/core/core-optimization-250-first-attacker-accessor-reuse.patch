Subject: [PATCH] core-optimization-250-first-attacker-accessor-reuse

---
 src/game/Objects/Player.cpp | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/src/game/Objects/Player.cpp b/src/game/Objects/Player.cpp
index ee4ecdc..51e125d 100644
--- a/src/game/Objects/Player.cpp
+++ b/src/game/Objects/Player.cpp
@@ -2050,8 +2050,8 @@ void Player::CinematicEnd()
 
 Unit* Player::GetFirstAttacker() const
 {
-    auto attacker = GetAttackers().size() > 0 ? (*GetAttackers().begin()) : nullptr;
-    return attacker;
+    AttackerSet const& attackers = GetAttackers();
+    return attackers.empty() ? nullptr : *attackers.begin();
 }
 
 void Player::LogHCDeath()
