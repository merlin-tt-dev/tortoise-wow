From f43de32e6cc4a703c4099a25b1fd7ab114830c3c Mon Sep 17 00:00:00 2001
From: Tortoise Audit <audit@local.invalid>
Date: Fri, 11 Sep 2026 11:14:18 +0000
Subject: [PATCH] core-optimization-263-eventai-victim-value-reuse

---
 src/game/AI/CreatureEventAI.cpp | 24 ++++++++++++++++++++----
 1 file changed, 20 insertions(+), 4 deletions(-)

diff --git a/src/game/AI/CreatureEventAI.cpp b/src/game/AI/CreatureEventAI.cpp
index 02c96ab..b086491 100644
--- a/src/game/AI/CreatureEventAI.cpp
+++ b/src/game/AI/CreatureEventAI.cpp
@@ -217,10 +217,18 @@ bool CreatureEventAI::ProcessEvent(CreatureEventAIHolder& pHolder, WorldObject*
         }
         case EVENT_T_TARGET_HP:
         {
-            if (!m_creature->IsInCombat() || !m_creature->GetVictim() || !m_creature->GetVictim()->GetMaxHealth())
+            if (!m_creature->IsInCombat())
+                return false;
+
+            Unit* victim = m_creature->GetVictim();
+            if (!victim)
+                return false;
+
+            uint32 maxHealth = victim->GetMaxHealth();
+            if (!maxHealth)
                 return false;
 
-            uint32 perc = (m_creature->GetVictim()->GetHealth() * 100) / m_creature->GetVictim()->GetMaxHealth();
+            uint32 perc = (victim->GetHealth() * 100) / maxHealth;
 
             if (perc > event.percent_range.percentMax || perc < event.percent_range.percentMin)
                 return false;
@@ -301,10 +309,18 @@ bool CreatureEventAI::ProcessEvent(CreatureEventAIHolder& pHolder, WorldObject*
         }
         case EVENT_T_TARGET_MANA:
         {
-            if (!m_creature->IsInCombat() || !m_creature->GetVictim() || !m_creature->GetVictim()->GetMaxPower(POWER_MANA))
+            if (!m_creature->IsInCombat())
+                return false;
+
+            Unit* victim = m_creature->GetVictim();
+            if (!victim)
+                return false;
+
+            uint32 maxMana = victim->GetMaxPower(POWER_MANA);
+            if (!maxMana)
                 return false;
 
-            uint32 perc = (m_creature->GetVictim()->GetPower(POWER_MANA) * 100) / m_creature->GetVictim()->GetMaxPower(POWER_MANA);
+            uint32 perc = (victim->GetPower(POWER_MANA) * 100) / maxMana;
 
             if (perc > event.percent_range.percentMax || perc < event.percent_range.percentMin)
                 return false;
-- 
2.47.3

