diff --git a/dep/dpp/CMakeLists.txt b/dep/dpp/CMakeLists.txt
--- a/dep/dpp/CMakeLists.txt
+++ b/dep/dpp/CMakeLists.txt
@@ -1,6 +1,13 @@
 else()
   include_directories(${CMAKE_SOURCE_DIR}/dep/windows/include/zlib)
   if(MINGW)
-    target_link_libraries(dpp PUBLIC zlib optimized ${OPENSSL_LIBRARIES})
+    target_link_libraries(dpp PUBLIC zlib)
+    foreach(_dpp_openssl_library ${OPENSSL_LIBRARIES})
+      target_link_libraries(dpp PUBLIC optimized ${_dpp_openssl_library})
+    endforeach()
+    foreach(_dpp_openssl_library ${OPENSSL_DEBUG_LIBRARIES})
+      target_link_libraries(dpp PUBLIC debug ${_dpp_openssl_library})
+    endforeach()
+    target_link_libraries(dpp PUBLIC ws2_32)
   endif()
 endif()
