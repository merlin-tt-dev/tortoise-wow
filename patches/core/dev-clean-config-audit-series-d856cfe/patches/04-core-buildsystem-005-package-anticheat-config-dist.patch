+# The active AnticheatConfig is a separate Config instance and reads
+# anticheat.conf directly. Publish the existing read-only profile as the safe
+# distribution template instead of mixing AnticheatConf into mangosd.conf.d.
+configure_file(
+  ${CMAKE_SOURCE_DIR}/src/game/Anticheat/anticheat.conf.readonly
+  ${CMAKE_CURRENT_BINARY_DIR}/anticheat.conf.dist
+  COPYONLY
+)
+install(FILES
+  ${CMAKE_CURRENT_BINARY_DIR}/anticheat.conf.dist
+  DESTINATION ${CONF_DIR}
+)
+
